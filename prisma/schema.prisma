// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Access levels, from most to least privileged. STAFF is deliberately "everything except
// destroying data" — see src/lib/auth/permissions.ts, which is the single source of truth for
// what each role may do; never re-derive these rules inline at a call site.
enum Role {
  ADMIN
  STAFF
  VIEWER
}

enum UnitStatus {
  DUE
  DONE
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  passwordHash   String
  name           String
  role           Role            @default(STAFF)
  createdAt      DateTime        @default(now())
  uploadLogs     UploadLog[]
  pendingUploads PendingUpload[]
  amcOffers      AmcOffer[]
}

// Holds a just-uploaded workbook's raw bytes between the wizard's steps (mapping confirmation,
// preview, commit), since those are separate requests and the file itself is too large/awkward
// to round-trip through hidden form fields. Deleted once the upload is committed.
model PendingUpload {
  id           String   @id @default(cuid())
  fileName     String
  fileData     Bytes
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model AppSettings {
  id                         Int    @id @default(1)
  defaultServiceIntervalDays Int    @default(90)
  renewalAlertLeadDays       Int    @default(30)
  companyName                String @default("Dhruvisha HVAC Systems Pvt. Ltd.")
  companyAddress             String @default("")
  companyPhone               String @default("")
  companyEmail               String @default("")
  offerTaxPercent            Float  @default(18)
  offerTermsText             String @default("")

  // The fixed wording and details of the printed AMC offer, taken from the company's existing
  // offer document so a generated offer matches what customers already receive.
  offerHsnCode      String @default("995469")
  offerSignatory    String @default("Mr. Dharmesh Sheth")
  offerCityLine     String @default("Ahmedabad")
  offerStateLine    String @default("Gujarat")
  offerIntroText    String @default("Please find herewith our most competitive Annual Maintenance Contract offer for comprehensive and four services in one year and any breakdown.")
  offerContractTerm String @default("One year from the date of PO and Payment")
  offerFooterNote   String @default("Please note that all machines will be checked & repaired on chargeable basis before taking this into AMC.")

  // How far ahead the in-app alert starts warning about a service or renewal falling due.
  reminderLeadDays Int @default(14)
}

model Project {
  id                          String      @id @default(cuid())
  name                        String
  normalizedName              String      @unique
  address                     String?
  columnMapping               Json?
  headerHash                  String?
  serviceIntervalDaysOverride Int?
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt
  units                       Unit[]
  uploadLogs                  UploadLog[]
  complaints                  Complaint[]
  amcOffers                   AmcOffer[]
}

model Unit {
  id                     String         @id @default(cuid())
  projectId              String
  project                Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceRowNumber        Int
  srNoRaw                String?
  block                  String?
  flatNo                 String?
  address                String?
  siteName               String?
  // Retained (and still populated by past uploads) but no longer surfaced anywhere in the UI,
  // import mapping, or export — see the "delete Contact No." requirement. Kept as a column so
  // existing numbers aren't destroyed and can be reinstated without data loss.
  contactInfo            String?
  hp                     Float?
  through                String?
  type                   String?
  amcPeriodText          String?
  amcPeriodStart         DateTime?
  amcPeriodEnd           DateTime?
  newAmcPeriodText       String?
  newAmcPeriodStart      DateTime?
  newAmcPeriodEnd        DateTime?
  billNo                 String?
  remarks                String?
  status                 UnitStatus     @default(DUE)
  statusManualOverride   Boolean        @default(false)
  lastServiceDate        DateTime?
  nextServiceDueDate     DateTime?
  // Renewal is tracked separately from service: nextServiceDueDate is when the next visit is
  // owed, renewalDueDateOverride is when the contract itself must be renewed. When null the
  // renewal date falls back to the AMC period end — see resolveRenewalDueDate in lib/status.ts.
  renewalDueDateOverride DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  visits                 ServiceVisit[]
  complaints             Complaint[]
  amcOffers              AmcOffer[]

  @@index([projectId])
  @@index([nextServiceDueDate])
  @@index([amcPeriodEnd])
  @@index([newAmcPeriodEnd])
  @@index([renewalDueDateOverride])
}

enum VisitStatus {
  DONE
  PENDING
}

model ServiceVisit {
  id            String      @id @default(cuid())
  unitId        String
  unit          Unit        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  sequence      Int
  // A DONE visit records visitDate (when it actually happened); a PENDING one records
  // scheduledDate (when it is owed). The service-history view reports both against their date.
  status        VisitStatus @default(DONE)
  visitDate     DateTime?
  scheduledDate DateTime?
  technicianId  String?
  technician    Technician? @relation(fields: [technicianId], references: [id])
  notes         String?
  rawText       String?
  createdAt     DateTime    @default(now())

  @@index([unitId])
  @@index([status])
  @@index([technicianId])
}

model Technician {
  id             String         @id @default(cuid())
  name           String
  normalizedName String         @unique
  phone          String?
  skills         String?
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  complaints     Complaint[]    @relation("ComplaintLeadTechnician")
  complaints2    Complaint[]    @relation("ComplaintSecondTechnician")
  visits         ServiceVisit[]
}

enum ComplaintStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
}

model Complaint {
  id              String            @id @default(cuid())
  ticketNo        String            @unique
  projectId       String?
  project         Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  unitId          String?
  unit            Unit?             @relation(fields: [unitId], references: [id], onDelete: SetNull)
  complainantName String?
  contactNumber   String?
  subject         String
  description     String?
  priority        ComplaintPriority @default(MEDIUM)
  status          ComplaintStatus   @default(OPEN)
  // The technicians attending this complaint, name-wise. Two of them attend, so there are two
  // named slots rather than one — `technician` is the lead, `technician2` the second.
  technicianId    String?
  technician      Technician?       @relation("ComplaintLeadTechnician", fields: [technicianId], references: [id], onDelete: SetNull)
  technician2Id   String?
  technician2     Technician?       @relation("ComplaintSecondTechnician", fields: [technician2Id], references: [id], onDelete: SetNull)
  reportedAt      DateTime          @default(now())
  attendedAt      DateTime?
  resolvedAt      DateTime?
  resolutionNotes String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([projectId])
  @@index([unitId])
  @@index([technicianId])
  @@index([technician2Id])
  @@index([status])
}

enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model AmcOffer {
  id              String         @id @default(cuid())
  offerNo         String         @unique
  projectId       String?
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  // Set when the offer covers a single flat rather than the whole project — this is what makes
  // offers generatable both project-wise and flat-wise.
  unitId          String?
  unit            Unit?          @relation(fields: [unitId], references: [id], onDelete: SetNull)
  customerName    String
  customerAddress String?
  // Printed as "Site Address:" on the offer, separately from the customer's postal address.
  siteAddress     String?
  // The equipment heading above the line items, e.g. "LG MAKE VRF SYSTEMS".
  systemHeading   String?
  hsnCode         String?
  // Free text under "Contract Period", e.g. "One year from the date of PO and Payment".
  contractTerm    String?
  offerDate       DateTime       @default(now())
  validUntil      DateTime?
  periodStart     DateTime?
  periodEnd       DateTime?
  taxPercent      Float          @default(18)
  notes           String?
  termsText       String?
  status          OfferStatus    @default(DRAFT)
  createdById     String
  createdBy       User           @relation(fields: [createdById], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  items           AmcOfferItem[]

  @@index([projectId])
  @@index([unitId])
  @@index([status])
}

model AmcOfferItem {
  id          String   @id @default(cuid())
  offerId     String
  offer       AmcOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  sequence    Int
  description String
  hp          Float?
  quantity    Int      @default(1)
  unitRate    Float    @default(0)

  @@index([offerId])
}

model UploadLog {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id])
  fileName     String
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())
  rowCount     Int
  warnings     Json?

  @@index([projectId])
}
